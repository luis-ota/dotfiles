#!/bin/bash

# Set PulseAudio environment variables
export PULSE_SERVER="unix:/run/user/$(id -u)/pulse/native"
export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"

# Idle time threshold in milliseconds (10 minutes = 600000 ms)
IDLE_THRESHOLD=600000

# Get the current idle time
IDLE_TIME=$(xprintidle)

# Check if any audio sink is running
AUDIO_RUNNING=$(pactl list sinks 2>/dev/null | grep -q 'State: RUNNING' && echo true || echo false)

# Get battery status (use acpi for battery details)
BATTERY_STATUS=$(acpi -b 2>/dev/null | grep -oP '(Charging|Discharging)' | head -1)
BATTERY_PERCENT=$(acpi -b 2>/dev/null | grep -oP '\d+%' | head -1 | tr -d '%')
BATTERY_PERCENT=${BATTERY_PERCENT:-100}

# Logic: Hibernate if battery is low (below 15%) and idle for 10 minutes
# (must be checked BEFORE suspend, otherwise the generic suspend condition matches first)
if [ "$BATTERY_STATUS" = "Discharging" ] && [ "$BATTERY_PERCENT" -le 15 ] && [ "$IDLE_TIME" -ge "$IDLE_THRESHOLD" ] && [ "$AUDIO_RUNNING" = false ]; then
    systemctl hibernate
# Logic: Sleep after 10 minutes idle and no audio is playing
elif [ "$IDLE_TIME" -ge "$IDLE_THRESHOLD" ] && [ "$AUDIO_RUNNING" = false ]; then
    systemctl suspend
fi